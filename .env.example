# Copia este archivo a .env.local y rellena. NUNCA subas .env.local al repo.

# URL canónica (Todos los entornos)
NEXT_PUBLIC_SITE_URL=

# Número de WhatsApp en formato internacional sin "+" ni espacios (Todos). Si está vacío, el botón no se pinta.
NEXT_PUBLIC_WHATSAPP=

# Medición GA4 (Producción) — Fase 8
NEXT_PUBLIC_GA_ID=

# Contacto de /agencia/ (sin formulario): cada botón solo se pinta si su variable existe
NEXT_PUBLIC_AGENCIA_EMAIL=
# Si falta, la llamada usa NEXT_PUBLIC_WHATSAPP
NEXT_PUBLIC_AGENCIA_TELEFONO=

# Token de /api/fichas-export (Producción)
FICHAS_EXPORT_TOKEN=

# Hasta que el dominio esté apuntado, la web no se indexa (noindex). Poner LANZADO=1 SOLO al lanzar (Fase 9): abre a buscadores.
LANZADO=
