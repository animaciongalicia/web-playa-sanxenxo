# Copia este archivo a .env.local y rellena. NUNCA subas .env.local al repo.

# URL canónica (Todos los entornos)
NEXT_PUBLIC_SITE_URL=

# Número de WhatsApp en formato internacional sin "+" ni espacios (Todos). Si está vacío, el botón no se pinta.
NEXT_PUBLIC_WHATSAPP=

# Medición GA4 (Producción) — Fase 8
NEXT_PUBLIC_GA_ID=

# Formulario de /agencia/ (Producción y Vista previa) — Fase 6
AGENCIA_DESTINO_EMAIL=
AGENCIA_API_KEY=

# Token de /api/fichas-export (Producción)
FICHAS_EXPORT_TOKEN=

# Modo revisión: en la vista previa enseña también las fichas pendientes (publicar null). Poner 1 SOLO en Preview/local, nunca en Producción.
MOSTRAR_PENDIENTES=
